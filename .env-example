# Backend de persistência do workflow.
# Use "filesystem" para salvar em arquivos locais ou "sqlite" para salvar no banco SQLite.
WORKFLOW_BACKEND=filesystem

# Caminho base usado quando WORKFLOW_BACKEND=filesystem.
# Exemplo: data/workflows
WORKFLOW_BASE_PATH=data/workflows

# Caminho do arquivo SQLite usado quando WORKFLOW_BACKEND=sqlite.
# Exemplo: data/workflows/workflows.db
WORKFLOW_SQLITE_PATH=data/workflows/workflows.db

# Ativa execução mock dos agentes (1=mock, 0=real).
# Em desenvolvimento e testes sem dependências externas, use 1.
AGNO_MOCK=1
